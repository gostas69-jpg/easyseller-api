{
    "name": "easyseller/site-sdk",
    "description": "PHP-библиотека для подключения своего сайта к EasySeller: товары, заказы, склады, остатки и изменения из EasySeller по протоколу 2",
    "type": "library",
    "license": "MIT",
    "keywords": ["easyseller", "ecommerce", "kaspi", "ozon", "wildberries", "marketplace", "stock", "sdk"],
    "homepage": "https://easyseller.kz",
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "suggest": {
        "ext-curl": "Запросы к EasySeller через curl; без него идут через потоки PHP",
        "ext-pdo": "Готовое хранилище PdoStorage (MySQL, MariaDB, SQLite)"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "EasySeller\\SiteSdk\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "EasySeller\\SiteSdk\\Tests\\": "tests/" }
    },
    "config": { "sort-packages": true }
}
